# MongoDB Atlas connection string. Include the db name (e.g. /dp-tracker).
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/dp-tracker?retryWrites=true&w=majority

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
